{
  "expo": {
    "name": "Les Plantes Sacrées d’Afrique de l’Ouest",
    "slug": "animaux-sacres-afrique",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-plantes-sacrees.png",
    "scheme": "plantessacrees",
    "userInterfaceStyle": "dark",
    "updates": {
      "url": "https://u.expo.dev/cb62d8b0-1962-4974-9bc9-987d7c68a92e",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ouedraogophillips.plantessacrees",
      "infoPlist": {
        "NSCameraUsageDescription": "Utilisé pour prendre des photos de plantes afin de les identifier.",
        "NSPhotoLibraryUsageDescription": "Utilisé pour sélectionner des photos de plantes depuis votre galerie."
      }
    },
    "android": {
      "package": "com.sotyssi.plantessacrees",
      "versionCode": 6,
      "backgroundColor": "#120A05",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-plantes-sacrees.png",
        "backgroundColor": "#120A05"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/images/logo-plantes-sacrees.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-plantes-sacrees.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#120A05"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Utilisé pour sélectionner des photos de plantes depuis votre galerie.",
          "cameraPermission": "Utilisé pour prendre des photos de plantes afin de les identifier.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo-plantes-sacrees.png",
          "color": "#D4A017",
          "sounds": []
        }
      ],
      "expo-asset",
      "./plugins/withPlayUploadSigning"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://les-plantes-sacr-es-de-l-afrique-de-l-ouest-production.up.railway.app/api",
      "eas": {
        "projectId": "cb62d8b0-1962-4974-9bc9-987d7c68a92e"
      }
    },
    "owner": "wagaraaga"
  }
}
